# Port di LAPTOP (host) untuk docker compose. Default: API 8000, UI 8501.
# Port bentrok? Salin file ini menjadi .env lalu ganti angkanya:
#   macOS/Linux : cp .env.example .env
#   PowerShell  : Copy-Item .env.example .env
# docker compose otomatis membaca .env yang ada di folder yang sama.
API_PORT=8000
UI_PORT=8501
